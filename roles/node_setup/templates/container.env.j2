# Environment variables of the service's container: its settings and secrets.
# Kept out of git (see .gitignore) and out of the image. `ansible-playbook deploy.yml`
# installs it on the servers, readable by root and the service's account only.
# One KEY=value per line, without quotes. For example:
# DATABASE_URL=postgres://orders:secret@db.example.com:5432/orders
