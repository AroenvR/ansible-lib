# Runs {{ __node_setup_name }} as a rootless Podman service (a Quadlet file).
# `ansible-playbook acme.infra.node_deploy` installs it on the servers in
# inventory.yml and sets Image= to the version it deploys. Change anything else
# as you need: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Unit]
Description={{ __node_setup_name }}

[Container]
Image={{ __node_setup_image }}
ContainerName={{ __node_setup_service }}
# <port on the server>:<port the app listens on>. Services sharing a server need
# different server ports.
PublishPort=3000:3000
# Settings and secrets: the deploy copies deploy/container.env here.
EnvironmentFile=%h/{{ __node_setup_service }}/container.env
# Data that outlives the container. :U gives it to the app's user.
Volume=%h/{{ __node_setup_service }}/data:/data:Z,U

[Service]
# Creates the data directory on the first start.
ExecStartPre=/usr/bin/mkdir -p %h/{{ __node_setup_service }}/data
Restart=always

[Install]
# Start at boot (the deploy lets this account run services without being logged in).
WantedBy=default.target
