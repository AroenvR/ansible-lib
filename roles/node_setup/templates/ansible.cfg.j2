# Ansible settings for building and deploying the project. Run every ansible-playbook command
# from this directory; see README.md.
[defaults]
inventory = inventory.yml
# Every run writes its output to a file of its own in logs/ (kept out of git), named after
# the playbook and the time: logs/deploy-20261003T081502Z.log.
callbacks_enabled = aslib.infra.run_log
