# Generated by acme.infra.node_image. Change the role's variables instead of editing this file.

# Build stage: Red Hat's Node.js builder image has gcc, g++, make and Python 3 for native modules.
FROM {{ node_image_registry }}/ubi9/nodejs-{{ __node_image_node_major }} AS build
{% if node_image_build_packages %}
USER 0
RUN dnf install --assumeyes --setopt=tsflags=nodocs {{ node_image_build_packages | join(' ') }} \
 && dnf clean all
USER 1001
{% endif %}
WORKDIR /opt/app-root/src
ENV npm_config_registry={{ node_image_npm_registry }} \
    npm_config_cache=/tmp/npm-cache \
    npm_config_audit=false \
    npm_config_fund=false
COPY --chown=1001:0 . .
# npm ci always starts from an empty node_modules, so nothing built on the build machine ends up in the image.
RUN npm ci{% if 'build' in __node_image_package.scripts | default({}) %} && npm run build{% endif %} && npm prune --omit=dev && rm -f .npmrc

# Runtime stage: no compilers, runs as the unprivileged user 1001.
FROM {{ node_image_registry }}/ubi9/nodejs-{{ __node_image_node_major }}-minimal
{% if node_image_runtime_packages %}
USER 0
RUN microdnf install --assumeyes --nodocs {{ node_image_runtime_packages | join(' ') }} \
 && microdnf clean all
{% endif %}
USER 1001
WORKDIR /opt/app-root/src
COPY --from=build --chown=1001:0 /opt/app-root/src .
ENV NODE_ENV=production \
    PORT={{ node_image_port }}
EXPOSE {{ node_image_port }}
CMD {{ node_image_command | to_json }}
