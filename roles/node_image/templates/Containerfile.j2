# Generated by acme.infra.node_image. Change the role's variables instead of editing this file.
# /opt/app-root/src is a fixed path, not a placeholder: the app's directory in
# Red Hat's Node.js images (their APP_ROOT is /opt/app-root, HOME /opt/app-root/src).

# Build stage: Red Hat's Node.js builder image has gcc, g++, make and Python 3 for native modules.
FROM {{ __node_image_builder }} AS build
{% if node_image_build_packages %}
USER 0
RUN dnf install --assumeyes --setopt=tsflags=nodocs {{ node_image_build_packages | join(' ') }} \
 && dnf clean all
USER 1001
{% endif %}
WORKDIR /opt/app-root/src
# npm takes its registry and other settings from the project's .npmrc, if there is one.
# node-gyp downloads the Node.js headers for native modules from npm_package_config_node_gyp_dist_url.
ENV npm_config_cache=/tmp/npm-cache \
    npm_config_audit=false \
    npm_config_fund=false \
    npm_package_config_node_gyp_dist_url={{ node_image_node_dist_url }}
COPY --chown=1001:0 . .
# Dependencies are installed in here, never copied from the build machine (node_modules is not in the build context).
RUN {{ 'npm ci' if __node_image_has_lockfile | bool else 'npm install' }} && npm run build && npm prune --omit=dev && rm -f .npmrc \
 && chmod -R go-w .

# Runtime stage: no compilers, runs as the unprivileged user 1001. The app's
# files belong to root and only root may write them, so the app cannot change its own code.
FROM {{ __node_image_runtime }}
{% if node_image_runtime_packages %}
USER 0
RUN microdnf install --assumeyes --nodocs {{ node_image_runtime_packages | join(' ') }} \
 && microdnf clean all
{% endif %}
USER 1001
WORKDIR /opt/app-root/src
COPY --from=build --chown=0:0 /opt/app-root/src .
ENV NODE_ENV=production \
    PORT={{ node_image_port }}
LABEL org.opencontainers.image.title="{{ __node_image_package.name }}" \
      org.opencontainers.image.version="{{ __node_image_package.version }}" \
      org.opencontainers.image.revision="{{ __node_image_commit.stdout | default('') }}"
EXPOSE {{ node_image_port }}
CMD ["npm", "run", "start:prod"]
