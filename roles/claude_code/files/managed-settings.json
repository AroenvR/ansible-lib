{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "enableWorkflows": true,
  "ultracode": true,
  "plansDirectory": "./plans",
  "permissions": {
    "deny": [
      "Edit(//etc/claude-code/**)",
      "Read(.env)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.mcp.json)",
      "Edit(**/.git/hooks/**)",
      "Edit(**/.git/config)"
    ]
  }
}
