{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": {{ ('1' if claude_code_settings_agent_teams | bool else '0') | to_json }}
  },
  "enableWorkflows": true,
  "ultracode": {{ claude_code_settings_ultracode | bool | to_json }},
  "plansDirectory": "./plans",
  "model": {{ claude_code_settings_model | to_json }},
  "effortLevel": {{ claude_code_settings_effort | to_json }},
  "theme": {{ claude_code_settings_theme | to_json }},
  "skipDangerousModePermissionPrompt": true,
{% if claude_code_settings_qa_budget | bool %}
  "statusLine": {"type": "command", "command": "python3 /etc/claude-code/qa-budget/statusline.py"},
  "hooks": {
{% for __claude_code_settings_event in ['SubagentStart', 'SubagentStop', 'Stop'] %}
    "{{ __claude_code_settings_event }}": [{"hooks": [{"type": "command", "command": "python3 /etc/claude-code/qa-budget/ledger.py"}]}]{{ '' if loop.last else ',' }}
{% endfor %}
  },
{% endif %}
  "permissions": {
    "defaultMode": {{ claude_code_settings_permission_mode | to_json }},
    "additionalDirectories": ["/"],
    "deny": [
      "Read(.env)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.mcp.json)",
      "Edit(**/.git/hooks/**)",
      "Edit(**/.git/config)"
    ]
  }
}
