#!/bin/sh
# {{ __claude_code_podman_name }}: runs Claude Code in the always-on container {{ __claude_code_podman_name }}, as its account.
# Installed by aslib.infra.claude_code_podman; the next deploy replaces this file.
#
#   claude-code            an interactive session
#   claude-code ARGS...    ARGS go to claude, e.g. --continue, --resume, -p "a prompt", agents
#
# Root only. Without a terminal (a script, cron), it runs without one, e.g. with -p.
set -eu

account={{ __claude_code_podman_user }}
container={{ __claude_code_podman_name }}
workdir={{ __claude_code_podman_dir }}

[ "$(id -u)" -eq 0 ] || { echo "claude-code: run it as root, e.g. sudo -i" >&2; exit 1; }
uid=$(id -u "$account")

tty=
if [ -t 0 ] && [ -t 1 ]; then tty=--tty; fi

# The environment every claude process needs (aslib.infra.claude_code_settings)
# comes along: Claude Code reads it before any settings file.
#
# From /, which the account may enter: runuser keeps the working directory. It
# keeps the environment too, so the D-Bus address is set to the account's: a root
# shell entered with su carries its user's, with which Podman cannot reach the
# account's systemd ("no systemd user session available").
cd /
exec runuser --user="$account" -- \
  env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
  podman exec --interactive $tty --env=TERM="${TERM:-xterm-256color}" \
  {% for __claude_code_podman_env in claude_code_settings_environment | dict2items %}
  --env={{ (__claude_code_podman_env.key ~ '=' ~ __claude_code_podman_env.value) | quote }} \
  {% endfor %}
  --workdir="$workdir" "$container" claude "$@"
